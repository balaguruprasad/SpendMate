# Copy to .env and fill in. Validated by src/core/config at boot — bad values crash the process.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://app:app@localhost:5433/app?schema=public
TEST_DATABASE_URL=postgresql://app:app@localhost:5433/app_test?schema=public
DB_POOL_MAX=10

# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-min-32-chars
JWT_REFRESH_SECRET=change-me-different-min-32-chars

CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate limiting (applied to /api/* only). Defaults shown.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20

# Basic-auth for /docs, /redoc and /openapi.json. REQUIRED in production — when BOTH are set those
# routes need login; when unset they are DISABLED (404) so the API surface is never exposed.
# If the password starts with '#', QUOTE it: DOCS_PASSWORD="#secret" (dotenv drops a leading #).
DOCS_USERNAME=mesa
DOCS_PASSWORD=change-me

LOG_LEVEL=info

# Google Cloud Storage (file attachments). All optional — the app boots without them, but the
# attachment upload/download routes will error until they're set. The service-account JSON key
# and .env are gitignored — never commit them.
GCS_BUCKET_NAME=your_bucket_name
GCS_BUCKET_PREFIX=mesa-finance
GCS_SERVICE_ACCOUNT_PATH=service-account.json
GCS_PROJECT_ID=your-gcp-project-id
# false = proxy upload through the API (local default); true = pre-signed PUT URLs (prod).
GCS_USE_SIGNED_URLS=false
# Signed URL lifetime in seconds (default 1 year).
GCS_SIGNED_URL_EXPIRATION=31536000
